# ============================================================
# MAIN PROGRAM
# ============================================================

def main():

    global fall_detected
    global fall_time

    global verifying
    global verify_result

    global smoothed_y

    global latest_jpeg

    global gemma_commentary

    global last_seen_time

    global ball_seen_before


    print("=" * 60)

    print("STARTING LEMON DETECTOR")

    print("=" * 60)


    # Start ESP32-CAM

    grabber = FrameGrabber(
        ESP32_CAM_URL
    )


    print("Waiting for ESP32-CAM...")


    while grabber.get_frame() is None:

        time.sleep(0.05)


    print("ESP32-CAM CONNECTED!")


    # Start website

    threading.Thread(
        target=run_web_server,
        daemon=True
    ).start()


    print(
        f"Website: http://localhost:{WEB_PORT}"
    )


    fps_counter = 0
    fps_timer = time.time()
    fps_display = 0


    try:

        while True:


            raw_frame = grabber.get_frame()


            if raw_frame is None:

                continue


            now = time.time()


            # ================================================
            # RESIZE FRAME
            # ================================================

            if PROCESS_WIDTH is not None:


                scale = (
                    PROCESS_WIDTH
                    /
                    raw_frame.shape[1]
                )


                im = cv2.resize(

                    raw_frame,

                    (
                        PROCESS_WIDTH,

                        int(
                            raw_frame.shape[0]
                            *
                            scale
                        )
                    )

                )


            else:

                im = raw_frame.copy()


            height, width = im.shape[:2]


            # ================================================
            # YELLOW BALL DETECTION
            # ================================================

            blurred = cv2.GaussianBlur(
                im,
                (5, 5),
                0
            )


            hsv = cv2.cvtColor(
                blurred,
                cv2.COLOR_BGR2HSV
            )


            mask = cv2.inRange(
                hsv,
                LOWER_YELLOW,
                UPPER_YELLOW
            )


            # Remove noise

            mask = cv2.erode(
                mask,
                None,
                iterations=1
            )


            mask = cv2.dilate(
                mask,
                None,
                iterations=2
            )


            contours, _ = cv2.findContours(

                mask,

                cv2.RETR_EXTERNAL,

                cv2.CHAIN_APPROX_SIMPLE

            )


            best_contour = None

            best_area = 0


            # ================================================
            # FIND BEST CIRCULAR YELLOW OBJECT
            # ================================================

            for contour in contours:


                area = cv2.contourArea(
                    contour
                )


                if (
                    area < MIN_CONTOUR_AREA
                    or
                    area > MAX_CONTOUR_AREA
                ):

                    continue


                perimeter = cv2.arcLength(
                    contour,
                    True
                )


                if perimeter == 0:

                    continue


                circularity = (

                    4
                    *
                    np.pi
                    *
                    area

                    /

                    (
                        perimeter
                        **
                        2
                    )

                )


                # Ignore objects that are not ball-like

                if circularity < MIN_CIRCULARITY:

                    continue


                if area > best_area:


                    best_area = area

                    best_contour = contour


            # ================================================
            # DRAW FALL LINE
            # ================================================

            cv2.line(

                im,

                (0, FALL_LINE),

                (width, FALL_LINE),

                (255, 0, 0),

                2

            )


            cv2.putText(

                im,

                "FALL LINE",

                (10, FALL_LINE - 10),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.5,

                (255, 0, 0),

                2

            )


            # ================================================
            # GET GEMMA RESULT
            # ================================================

            if (

                verifying

                and

                verify_result is not None

            ):


                if verify_result:


                    print()
                    print("=" * 50)
                    print("LEMON FALL CONFIRMED!")
                    print("=" * 50)
                    print()


                    fall_detected = True

                    fall_time = now


                else:


                    print(
                        "Gemma rejected the fall."
                    )


                    fall_detected = False


                verifying = False

                verify_result = None

                y_history.clear()

                smoothed_y = None


            # ================================================
            # RESET AFTER COOLDOWN
            # ================================================

            if (

                fall_detected

                and

                (
                    now - fall_time
                )

                >
                FALL_COOLDOWN_SECONDS

            ):


                fall_detected = False

                y_history.clear()

                smoothed_y = None


            velocity = 0

            state = "stable"


            # ================================================
            # BALL DETECTED
            # ================================================

            if best_contour is not None:


                last_seen_time = now

                ball_seen_before = True


                x, y, w, h = cv2.boundingRect(
                    best_contour
                )


                center_x = int(
                    x + w / 2
                )


                center_y = int(
                    y + h / 2
                )


                # ============================================
                # SMOOTH BALL POSITION
                # ============================================

                if smoothed_y is None:


                    smoothed_y = center_y


                else:


                    smoothed_y = (

                        EMA_ALPHA
                        *
                        center_y

                        +

                        (
                            1 - EMA_ALPHA
                        )
                        *
                        smoothed_y

                    )


                # ============================================
                # DRAW BALL BOX
                # ============================================

                cv2.rectangle(

                    im,

                    (x, y),

                    (x + w, y + h),

                    (0, 255, 255),

                    2

                )


                cv2.circle(

                    im,

                    (
                        center_x,
                        int(smoothed_y)
                    ),

                    6,

                    (0, 0, 255),

                    -1

                )


                cv2.putText(

                    im,

                    "LEMON",

                    (
                        x,
                        max(
                            y - 10,
                            20
                        )
                    ),

                    cv2.FONT_HERSHEY_SIMPLEX,

                    0.6,

                    (0, 255, 255),

                    2

                )


                # ============================================
                # STORE POSITION HISTORY
                # ============================================

                if (

                    not fall_detected

                    and

                    not verifying

                ):


                    y_history.append(

                        (
                            now,
                            smoothed_y
                        )

                    )


                # Remove old history

                while (

                    y_history

                    and

                    (
                        now
                        -
                        y_history[0][0]
                    )

                    >
                    HISTORY_WINDOW_SECONDS

                ):


                    y_history.popleft()


                # ============================================
                # CALCULATE VELOCITY
                # ============================================

                if len(y_history) >= 2:


                    t_old, y_old = (
                        y_history[0]
                    )


                    t_new, y_new = (
                        y_history[-1]
                    )


                    dt = t_new - t_old


                    if dt > 0:


                        velocity = (
                            y_new - y_old
                        ) / dt


                    # ========================================
                    # SUSPECT BALL FALL
                    # ========================================

                    if (

                        velocity
                        >
                        FALL_VELOCITY_THRESHOLD

                        and

                        smoothed_y
                        >=
                        FALL_LINE

                        and

                        not fall_detected

                        and

                        not verifying

                    ):


                        print(

                            f"Suspected ball fall: "

                            f"{velocity:.0f} px/s"

                        )


                        verifying = True

                        verify_result = None

                        gemma_commentary = ""


                        threading.Thread(

                            target=verify_with_gemma,

                            args=(
                                raw_frame.copy(),
                            ),

                            daemon=True

                        ).start()


                # ============================================
                # DISPLAY STATE
                # ============================================

                if fall_detected:


                    state = "eliminated"


                    cv2.putText(

                        im,

                        "LEMON HAS FALLEN!",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.9,

                        (0, 0, 255),

                        3

                    )


                elif verifying:


                    state = "verifying"


                    cv2.putText(

                        im,

                        "VERIFYING WITH GEMMA...",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.7,

                        (0, 165, 255),

                        2

                    )


                elif velocity > 50:


                    state = "moving"


                    cv2.putText(

                        im,

                        f"LEMON MOVING {velocity:.0f} px/s",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.7,

                        (0, 255, 255),

                        2

                    )


                else:


                    state = "stable"


                    cv2.putText(

                        im,

                        "LEMON STABLE",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.7,

                        (0, 255, 0),

                        2

                    )


            # ================================================
            # NO BALL DETECTED
            # ================================================

            else:


                if fall_detected:


                    state = "eliminated"


                    cv2.putText(

                        im,

                        "LEMON HAS FALLEN!",
                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.9,

                        (0, 0, 255),

                        3

                    )


                elif (

                    ball_seen_before

                    and

                    not verifying

                    and

                    (
                        now
                        -
                        last_seen_time
                    )

                    >
                    OUT_OF_FRAME_GRACE_SECONDS

                ):


                    print()
                    print("=" * 50)
                    print(
                        "LEMON Fell Down"
                    )
                    print("=" * 50)
                    print()


                    fall_detected = True

                    fall_time = now


                    gemma_commentary = (
                        "Lemon disappeared from the camera frame."
                    )


                    ball_seen_before = False

                    y_history.clear()

                    smoothed_y = None


                    state = "eliminated"


                    cv2.putText(

                        im,

                        "LEMON HAS FALLEN!",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.9,

                        (0, 0, 255),

                        3

                    )


                else:


                    state = "stable"


                    cv2.putText(

                        im,

                        "LEMON NOT DETECTED",

                        (10, 40),

                        cv2.FONT_HERSHEY_SIMPLEX,

                        0.7,

                        (0, 0, 255),

                        2

                    )


            # ================================================
            # FPS
            # ================================================

            fps_counter += 1


            if now - fps_timer >= 1:


                fps_display = fps_counter

                fps_counter = 0

                fps_timer = now


            cv2.putText(

                im,

                f"FPS: {fps_display}",

                (width - 90, 25),

                cv2.FONT_HERSHEY_SIMPLEX,

                0.5,

                (200, 200, 200),

                1

            )


            # ================================================
            # SEND FRAME TO WEBSITE
            # ================================================

            ok, jpeg_buffer = cv2.imencode(
                ".jpg",
                im
            )


            if ok:


                with web_lock:


                    latest_jpeg = (
                        jpeg_buffer.tobytes()
                    )


                    latest_status["state"] = state


                    latest_status["velocity"] = velocity


                    latest_status["commentary"] = (
                        gemma_commentary
                    )


                    latest_status["updated_at"] = now


            # ================================================
            # SHOW OPENCV WINDOW
            # ================================================

            cv2.imshow(
                "Lemon Detector",
                im
            )


            # Press Q to quit

            if (
                cv2.waitKey(1)
                &
                0xFF
                ==
                ord("q")
            ):

                break


    finally:


        print("Stopping...")


        grabber.stop()


        cv2.destroyAllWindows()


# ============================================================
# START PROGRAM
# ============================================================

if __name__ == "__main__":

    main()
