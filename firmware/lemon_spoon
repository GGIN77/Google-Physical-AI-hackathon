import cv2
import urllib.request
import numpy as np
import threading
import time
from collections import deque

# pip install ollama
# Also run once in a terminal before starting this script:
#   ollama pull gemma3:4b
import ollama

# ==============================
# ESP32-CAM SETTINGS
# ==============================

url = "http://10.25.172.137/cam-lo.jpg"

# ==============================
# GEMMA VERIFICATION SETTINGS
# ==============================

# Vision-capable Gemma model. gemma3:4b (or 12b/27b if your PC can
# handle it) supports image input. Must be pulled via `ollama pull`
# before running this script.
GEMMA_MODEL = "gemma3:4b"

VERIFY_PROMPT = (
    "Look at this image carefully. Answer with only one word, "
    "YES or NO: Does this image show a yellow object that has "
    "fallen or is in the middle of falling (not resting stable "
    "in its normal position)?"
)

# ==============================
# YELLOW COLOR DETECTION SETTINGS
# ==============================

LOWER_YELLOW = np.array([20, 90, 90])
UPPER_YELLOW = np.array([35, 255, 255])
MIN_CONTOUR_AREA = 150
MAX_CONTOUR_AREA = 15000
MIN_CIRCULARITY = 0.4  # lower this further (even to 0) if your object isn't round
PROCESS_WIDTH = 320

# ==============================
# FALL DETECTION SETTINGS
# ==============================

FALL_LINE = 180
POSITION_HISTORY = 8
HISTORY_WINDOW_SECONDS = 0.4
FALL_VELOCITY_THRESHOLD = 250
FALL_COOLDOWN_SECONDS = 1.5
EMA_ALPHA = 0.6

y_history = deque(maxlen=POSITION_HISTORY)
smoothed_y = None
fall_detected = False       # confirmed by Gemma
fall_time = 0

# --------------------------
# Gemma verification state
# --------------------------
# Verification runs in its own thread so a slow model call never
# blocks frame capture or on-screen tracking. Only one verification
# runs at a time - "verifying" gates new suspicions until it resolves.
verifying = False
verify_result = None   # None = pending, True/False = resolved


def verify_with_gemma(frame_bgr):
    """Runs in a background thread. Sends the frame to Gemma via
    Ollama and stores the yes/no verdict in verify_result."""
    global verify_result

    try:
        ok, buf = cv2.imencode(".jpg", frame_bgr)
        if not ok:
            verify_result = False
            return

        response = ollama.chat(
            model=GEMMA_MODEL,
            messages=[{
                "role": "user",
                "content": VERIFY_PROMPT,
                "images": [buf.tobytes()],
            }],
        )

        answer = response["message"]["content"].strip().upper()
        print(f"Gemma says: {answer}")
        verify_result = answer.startswith("YES")

    except Exception as e:
        print("Gemma verification error:", e)
        # Fail open: if Gemma/Ollama isn't reachable, fall back to
        # trusting the color+motion detector rather than silently
        # dropping every fall.
        verify_result = True


# ==============================
# BACKGROUND FRAME FETCHER
# ==============================

class FrameGrabber:

    def __init__(self, url):
        self.url = url
        self.frame = None
        self.lock = threading.Lock()
        self.running = True
        self.thread = threading.Thread(target=self._update, daemon=True)
        self.thread.start()

    def _update(self):
        while self.running:
            try:
                response = urllib.request.urlopen(self.url, timeout=3)
                data = response.read()
                im = cv2.imdecode(
                    np.frombuffer(data, dtype=np.uint8),
                    cv2.IMREAD_COLOR
                )
                if im is not None:
                    with self.lock:
                        self.frame = im
            except Exception as e:
                print("Fetch error:", e)
                time.sleep(0.2)

    def get_frame(self):
        with self.lock:
            return None if self.frame is None else self.frame.copy()

    def stop(self):
        self.running = False


print("Starting real-time yellow object tracker...")
grabber = FrameGrabber(url)

while grabber.get_frame() is None:
    time.sleep(0.02)

fps_counter = 0
fps_timer = time.time()
fps_display = 0


# ==============================
# MAIN LOOP
# ==============================

try:

    while True:

        raw_frame = grabber.get_frame()
        if raw_frame is None:
            continue

        now = time.time()

        if PROCESS_WIDTH is not None:
            scale = PROCESS_WIDTH / raw_frame.shape[1]
            im = cv2.resize(raw_frame, (PROCESS_WIDTH, int(raw_frame.shape[0] * scale)))
        else:
            im = raw_frame.copy()

        height, width = im.shape[:2]

        # --------------------------
        # Detect yellow, shape-filtered
        # --------------------------

        blurred = cv2.GaussianBlur(im, (5, 5), 0)
        hsv = cv2.cvtColor(blurred, cv2.COLOR_BGR2HSV)
        mask = cv2.inRange(hsv, LOWER_YELLOW, UPPER_YELLOW)
        mask = cv2.erode(mask, None, iterations=1)
        mask = cv2.dilate(mask, None, iterations=2)

        contours, _ = cv2.findContours(
            mask, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE
        )

        best_contour = None
        best_area = 0

        for c in contours:
            area = cv2.contourArea(c)
            if area < MIN_CONTOUR_AREA or area > MAX_CONTOUR_AREA:
                continue
            perimeter = cv2.arcLength(c, True)
            if perimeter == 0:
                continue
            circularity = 4 * np.pi * area / (perimeter ** 2)
            if circularity < MIN_CIRCULARITY:
                continue
            if area > best_area:
                best_area = area
                best_contour = c

        cv2.line(im, (0, FALL_LINE), (width, FALL_LINE), (255, 0, 0), 2)

        # --------------------------
        # Handle a resolved Gemma verification
        # --------------------------

        if verifying and verify_result is not None:
            if verify_result:
                print("")
                print("==============================")
                print("   PLAYER HAS BEEN ELIMINATED")
                print("==============================")
                print("")
                fall_detected = True
                fall_time = now
            else:
                print("Gemma says no fall - resuming tracking.")
                fall_detected = False

            verifying = False
            verify_result = None
            y_history.clear()
            smoothed_y = None

        # --------------------------
        # Cooldown after a confirmed fall
        # --------------------------

        if fall_detected and (now - fall_time) > FALL_COOLDOWN_SECONDS:
            fall_detected = False
            y_history.clear()
            smoothed_y = None

        velocity = 0

        if best_contour is not None:

            x, y, w, h = cv2.boundingRect(best_contour)
            center_x = int(x + w / 2)
            center_y = int(y + h / 2)

            if smoothed_y is None:
                smoothed_y = center_y
            else:
                smoothed_y = EMA_ALPHA * center_y + (1 - EMA_ALPHA) * smoothed_y

            cv2.rectangle(im, (x, y), (x + w, y + h), (0, 255, 255), 2)
            cv2.circle(im, (center_x, int(smoothed_y)), 5, (0, 0, 255), -1)

            if not fall_detected and not verifying:
                y_history.append((now, smoothed_y))

            while y_history and (now - y_history[0][0]) > HISTORY_WINDOW_SECONDS:
                y_history.popleft()

            if len(y_history) >= 2:
                t_old, y_old = y_history[0]
                t_new, y_new = y_history[-1]
                dt = t_new - t_old
                if dt > 0:
                    velocity = (y_new - y_old) / dt

                # --------------------------
                # Suspected fall -> hand off to Gemma
                # --------------------------

                if (
                    velocity > FALL_VELOCITY_THRESHOLD
                    and smoothed_y >= FALL_LINE
                    and not fall_detected
                    and not verifying
                ):
                    print(f"Suspected fall (velocity: {velocity:.0f}px/s) - asking Gemma to verify...")
                    verifying = True
                    verify_result = None
                    # Verify against the full-resolution raw frame,
                    # not the downscaled tracking frame, so Gemma
                    # gets the clearest possible image.
                    threading.Thread(
                        target=verify_with_gemma,
                        args=(raw_frame.copy(),),
                        daemon=True
                    ).start()

            # --------------------------
            # Status display
            # --------------------------

            if fall_detected:
                cv2.putText(im, "PLAYER ELIMINATED", (10, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.9, (0, 0, 255), 2)
            elif verifying:
                cv2.putText(im, "VERIFYING WITH GEMMA...", (10, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (255, 165, 0), 2)
            elif velocity > 50:
                cv2.putText(im, f"MOVING DOWN {velocity:.0f}px/s", (10, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
            else:
                cv2.putText(im, "OBJECT STABLE", (10, 40),
                            cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)

        else:
            cv2.putText(im, "NO YELLOW OBJECT DETECTED", (10, 40),
                        cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 0, 255), 2)

        # --------------------------
        # FPS counter
        # --------------------------

        fps_counter += 1
        if now - fps_timer >= 1.0:
            fps_display = fps_counter
            fps_counter = 0
            fps_timer = now

        cv2.putText(im, f"FPS: {fps_display}", (width - 90, 20),
                    cv2.FONT_HERSHEY_SIMPLEX, 0.5, (200, 200, 200), 1)

        cv2.imshow("Yellow Object Fall Detection", im)

        if cv2.waitKey(1) & 0xFF == ord("q"):
            break

finally:
    grabber.stop()
    cv2.destroyAllWindows()