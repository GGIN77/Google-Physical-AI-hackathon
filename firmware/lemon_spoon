# ============================================================
# YELLOW BALL DETECTION SETTINGS
# ============================================================

# HSV range for yellow
LOWER_YELLOW = np.array([20, 100, 100])
UPPER_YELLOW = np.array([40, 255, 255])

# Ignore objects that are too small or too large
MIN_CONTOUR_AREA = 150
MAX_CONTOUR_AREA = 30000

# Ball should be reasonably circular
MIN_CIRCULARITY = 0.55

# Process at this width for better performance
PROCESS_WIDTH = 320


# ============================================================
# FALL DETECTION SETTINGS
# ============================================================

# Horizontal line the ball must cross while moving down
FALL_LINE = 180

# Number of ball positions to remember
POSITION_HISTORY = 10

# Time window used for velocity calculation
HISTORY_WINDOW_SECONDS = 0.5

# Minimum downward velocity for suspected fall
FALL_VELOCITY_THRESHOLD = 250

# How long to show BALL DROPPED
FALL_COOLDOWN_SECONDS = 2.0

# Position smoothing
EMA_ALPHA = 0.6

# How long the ball can be missing before considering it gone
OUT_OF_FRAME_GRACE_SECONDS = 0.8


# ============================================================
# TRACKING VARIABLES
# ============================================================

y_history = deque(maxlen=POSITION_HISTORY)

smoothed_y = None

fall_detected = False
fall_time = 0

last_seen_time = 0

ball_seen_before = False


# ============================================================
# GEMMA VERIFICATION STATE
# ============================================================

verifying = False

verify_result = None

gemma_commentary = ""


# ============================================================
# SHARED WEB STATE
# ============================================================

web_lock = threading.Lock()

latest_jpeg = None

latest_status = {
    "state": "starting",
    "velocity": 0,
    "commentary": "",
    "updated_at": 0
}


# ============================================================
# GEMMA VERIFICATION
# ============================================================

def verify_with_gemma(frame_bgr):

    global verify_result
    global gemma_commentary

    try:

        print("Sending image to Gemma...")

        ok, buffer = cv2.imencode(".jpg", frame_bgr)

        if not ok:

            verify_result = False

            gemma_commentary = (
                "Could not encode image for verification."
            )

            return


        response = ollama.chat(

            model=GEMMA_MODEL,

            messages=[{

                "role": "user",

                "content": VERIFY_PROMPT,

                "images": [buffer.tobytes()]

            }]

        )


        raw = response["message"]["content"].strip()

        print("\nGemma Response:")
        print(raw)
        print()


        lines = [

            line.strip()

            for line in raw.splitlines()

            if line.strip()

        ]


        verdict_line = (

            lines[0].upper()

            if lines

            else ""

        )


        commentary_line = (

            lines[1]

            if len(lines) > 1

            else raw

        )


        verify_result = verdict_line.startswith("YES")

        gemma_commentary = commentary_line


    except Exception as e:

        print("Gemma error:", e)

        # If Gemma fails, trust motion detection
        verify_result = True

        gemma_commentary = (
            "AI unavailable - fall confirmed by motion detection."
        )


# ============================================================
# BACKGROUND ESP32-CAM FRAME GRABBER
# ============================================================

class FrameGrabber:

    def __init__(self, camera_url):

        self.url = camera_url

        self.frame = None

        self.lock = threading.Lock()

        self.running = True

        self.thread = threading.Thread(
            target=self._update,
            daemon=True
        )

        self.thread.start()


    def _update(self):

        while self.running:

            try:

                response = urllib.request.urlopen(
                    self.url,
                    timeout=3
                )

                data = response.read()

                image = cv2.imdecode(
                    np.frombuffer(
                        data,
                        dtype=np.uint8
                    ),
                    cv2.IMREAD_COLOR
                )

                if image is not None:

                    with self.lock:

                        self.frame = image


            except Exception as e:

                print("ESP32-CAM error:", e)

                time.sleep(0.2)


    def get_frame(self):

        with self.lock:

            if self.frame is None:

                return None

            return self.frame.copy()


    def stop(self):

        self.running = False


